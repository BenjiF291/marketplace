rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Account credentials and balances are accessed through the server only.
    match /users/{userId} {
      allow read, write: if false;
    }

    match /items/{itemId} {
      allow read, write: if true;
    }

    // Server Admin SDK owns ranked progression and login sessions.
    match /brawlProfiles/{id} { allow read, write: if false; }
    match /computerBattles/{id} { allow read, write: if false; }
    match /loginSessions/{id} { allow read, write: if false; }

    // Allow access to test collection for debugging
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}